[Unit]
Description=FreeShift API (Node 24 + SQLite)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/freeshift
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOST=127.0.0.1
Environment=TZ=Asia/Shanghai
Environment=DATABASE_PATH=/data/freeshift/freeshift.db
Environment=LOG_LEVEL=info
# 同一进程同时托管前端构建产物（apps/web/dist），更新时无需依赖 Nginx 的静态目录
Environment=SERVE_STATIC=/opt/freeshift/apps/web/dist
EnvironmentFile=-/data/freeshift/auth.env
ExecStart=/opt/node24/bin/node apps/server/src/index.ts
Restart=always
RestartSec=3
MemoryMax=384M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
