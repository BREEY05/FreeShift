# 数据库文件路径（相对仓库根或绝对路径）
DATABASE_PATH=./data/freeshift.db
# API 监听
PORT=3000
HOST=0.0.0.0
# 时区（决定“当前周”的计算）
TZ=Asia/Shanghai
LOG_LEVEL=info

# Email login (set false only for trusted offline use)
AUTH_ENABLED=true
APP_ORIGIN=https://freeshift.ainavi.online
AUTH_COOKIE_SECURE=true
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=380154843@qq.com
SMTP_FROM=380154843@qq.com
SMTP_PASS=replace-with-qq-smtp-authorization-code
